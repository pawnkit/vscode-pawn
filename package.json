{
  "name": "vscode-pawn",
  "displayName": "PawnKit",
  "description": "VS Code client for the PawnKit toolchain",
  "version": "0.18.22",
  "publisher": "pawnkit",
  "preview": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pawnkit/vscode-pawn.git"
  },
  "homepage": "https://github.com/pawnkit/vscode-pawn#readme",
  "bugs": {
    "url": "https://github.com/pawnkit/vscode-pawn/issues"
  },
  "keywords": [
    "pawn",
    "open.mp",
    "samp",
    "language server",
    "pawnkit"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Formatters",
    "Testing"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:pawn",
    "workspaceContains:pawn.json",
    "workspaceContains:pawn.yaml"
  ],
  "extensionKind": [
    "workspace"
  ],
  "files": [
    "dist/**",
    "language-configuration.json",
    "syntaxes/**",
    "schemas/**",
    "README.md",
    "CAPABILITIES.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --external:vscode --platform=node --format=cjs --outfile=dist/extension.js",
    "check": "tsc --noEmit",
    "test": "npm run check && esbuild test/*.test.ts --bundle --platform=node --format=cjs --outdir=dist-test && node --test dist-test/*.test.js",
    "package": "npm run check && npm run build && vsce package",
    "verify-package": "node test/verify-package.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.4.5"
  },
  "contributes": {
    "languages": [
      {
        "id": "pawn",
        "aliases": [
          "Pawn",
          "pawn"
        ],
        "extensions": [
          ".pwn",
          ".inc"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pawn",
        "scopeName": "source.pawn",
        "path": "./syntaxes/pawn.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "inactive",
        "superType": "comment",
        "description": "Code excluded by a preprocessor condition."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "pawn",
        "scopes": {
          "inactive": [
            "comment.block.pawn"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[pawn]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "walkthroughs": [
      {
        "id": "pawnkit.gettingStarted",
        "title": "Get started with PawnKit",
        "description": "Set up a Pawn project, check it, and run it from VS Code.",
        "steps": [
          {
            "id": "installTools",
            "title": "Install the PawnKit tools",
            "description": "Run [Install/Update Tools](command:pawn.installTools). PawnKit downloads pinned releases and verifies their checksums.",
            "completionEvents": [
              "onCommand:pawn.installTools"
            ]
          },
          {
            "id": "setupProject",
            "title": "Set up the project",
            "description": "Open a Pawn workspace, then [set up its manifest](command:pawn.setupProject). Existing `pawn.json` and `pawn.yaml` files are kept.",
            "completionEvents": [
              "onCommand:pawn.setupProject"
            ]
          },
          {
            "id": "checkStatus",
            "title": "Check the selected profile",
            "description": "Open [Project Status](command:pawn.showProjectHealth) to see the resolved profile, build, runtime, and project findings.",
            "completionEvents": [
              "onCommand:pawn.showProjectHealth"
            ]
          },
          {
            "id": "checkProject",
            "title": "Run project checks",
            "description": "Run [Check Project](command:pawn.check) to check formatting and lint diagnostics with the same project settings.",
            "completionEvents": [
              "onCommand:pawn.check"
            ]
          },
          {
            "id": "buildProject",
            "title": "Build the project",
            "description": "Configure a compiler or backend, then [build the project](command:pawn.build).",
            "completionEvents": [
              "onCommand:pawn.build"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "pawn.setupProject",
        "title": "PawnKit: Set Up Project"
      },
      {
        "command": "pawn.showProjectHealth",
        "title": "PawnKit: Show Project Status"
      },
      {
        "command": "pawn.restartServer",
        "title": "Pawn: Restart Language Server"
      },
      {
        "command": "pawn.showOutput",
        "title": "Pawn: Show Language Server Output"
      },
      {
        "command": "pawn.check",
        "title": "Pawn: Check Project"
      },
      {
        "command": "pawn.fmt",
        "title": "Pawn: Format Project"
      },
      {
        "command": "pawn.lint",
        "title": "Pawn: Lint Project"
      },
      {
        "command": "pawn.doctor",
        "title": "Pawn: Diagnose Project"
      },
      {
        "command": "pawn.build",
        "title": "Pawn: Build Project"
      },
      {
        "command": "pawn.run",
        "title": "Pawn: Run Project"
      },
      {
        "command": "pawn.installTools",
        "title": "PawnKit: Install/Update Tools"
      },
      {
        "command": "pawn.showToolVersions",
        "title": "PawnKit: Show Tool Versions"
      }
    ],
    "configuration": {
      "title": "PawnKit",
      "properties": {
        "pawn.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to pawnlsp. Empty uses PATH or the managed copy."
        },
        "pawn.server.trace": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window"
        },
        "pawn.cli.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to the pawn CLI. Empty uses PATH or the managed copy."
        },
        "pawn.build.compiler": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to pawncc for project builds."
        },
        "pawn.build.backend": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Path to an RFC 0012 build backend."
        },
        "pawn.build.artifact": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional output path for project builds."
        },
        "pawn.debug.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to pawndebug. Empty uses PATH or the managed copy."
        },
        "pawn.test.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path to pawntest. Empty uses PATH or the managed copy."
        },
        "pawn.test.discoveryArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "--list",
            "--format",
            "json"
          ],
          "scope": "resource"
        }
      }
    },
    "debuggers": [
      {
        "type": "pawn",
        "label": "Pawn Debug",
        "languages": [
          "pawn"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "AMX program to launch"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debug session"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "pawn",
            "request": "launch",
            "name": "Debug Pawn",
            "program": "${workspaceFolder}/gamemodes/main.amx"
          }
        ]
      }
    ],
    "taskDefinitions": [
      {
        "type": "pawn",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string",
            "enum": [
              "check",
              "fmt",
              "lint",
              "doctor",
              "build",
              "run"
            ]
          },
          "project": {
            "type": "string",
            "description": "Project root or manifest"
          },
          "profile": {
            "type": "string",
            "description": "Project profile"
          },
          "build": {
            "type": "string",
            "description": "Named build"
          },
          "runtime": {
            "type": "string",
            "description": "Named runtime"
          },
          "compiler": {
            "type": "string",
            "description": "Pawn compiler path"
          },
          "backend": {
            "type": "string",
            "description": "RFC 0012 backend path"
          },
          "artifact": {
            "type": "string",
            "description": "Output path"
          }
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": [
          "/pawn.json"
        ],
        "url": "./schemas/pawn.schema.json"
      },
      {
        "fileMatch": [
          "/pawn.lock",
          "/pawn-lock.json"
        ],
        "url": "./schemas/pawn-lock.schema.json"
      },
      {
        "fileMatch": [
          "/pawnlint.json",
          "/.pawnlint.json"
        ],
        "url": "./schemas/pawnlint.schema.json"
      }
    ]
  }
}
